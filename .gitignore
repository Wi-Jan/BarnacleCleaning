# ---------------------------------------------------------------
# Build artefacts — all regenerated by GUI/build.py, never commit.
# These account for ~6.6 GB of the working folder.
# ---------------------------------------------------------------
GUI/dist/
GUI/build/
GUI/installer_output/
*.exe
*.msi

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# ---------------------------------------------------------------
# Model weights
# Stock YOLO checkpoints download automatically via ultralytics.
# Trained weights (best.pt) are published as GitHub Release assets
# rather than committed — see README.
# ---------------------------------------------------------------
*.pt
AI/runs/

# ---------------------------------------------------------------
# Dataset images
# Third-party Roboflow dataset (CC BY 4.0) — linked in the README,
# not redistributed here. data.yaml and the Roboflow READMEs are
# kept so the layout and attribution stay visible.
# ---------------------------------------------------------------
AI/barnacles_dataset/train/
AI/barnacles_dataset/valid/
AI/barnacles_dataset/test/

# ---------------------------------------------------------------
# Runtime output
# ---------------------------------------------------------------
GUI/snapshots/
*.log
settings.json

# ---------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Backup files
*.bak

# ---------------------------------------------------------------
# Machine-local / stray files
# ---------------------------------------------------------------
.claude/
*.lnk
OnboardSteppers_ESP2/New Text Document.txt
